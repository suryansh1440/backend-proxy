# Secret token — the Electron app must send this in the x-proxy-secret header.
# Set this as an Environment Variable in your Vercel project dashboard too.
# Generate a random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SECRET=change-me-to-something-random

# Optional: override port for local dev (default: 3333)
# PROXY_PORT=3333
